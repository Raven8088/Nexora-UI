+# Stage 7: the client secret of nexora-console, a file of this folder that is never versioned (secrets/README.md),
+# mounted read-only in the frontend container as /run/secrets/nexora_console_client_secret: never in its environment,
+# its image or its logs. ("environment:" secrets are not possible: Compose refuses them in read-only services.)
+secrets:
+  nexora_console_client_secret:
+    file: ./secrets/nexora_console_client_secret
+
